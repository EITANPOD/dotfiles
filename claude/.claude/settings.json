{
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "command -v osascript &>/dev/null && osascript -e 'display notification \"Permission approval needed\" with title \"Claude Code - Action Required\"' || command -v notify-send &>/dev/null && notify-send 'Claude Code - Action Required' 'Permission approval needed'"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "command -v osascript &>/dev/null && osascript -e 'display notification \"Claude is done and waiting\" with title \"Claude Code\"' || command -v notify-send &>/dev/null && notify-send 'Claude Code' 'Claude is done and waiting'"
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "command -v osascript &>/dev/null && osascript -e 'display notification \"Claude is asking you a question\" with title \"Claude Code\"' || command -v notify-send &>/dev/null && notify-send 'Claude Code' 'Claude is asking you a question'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "everything-claude-code@everything-claude-code": true,
    "caveman@caveman": true,
    "superpowers@claude-plugins-official": true,
    "ultracost@ultracost": true,
    "claude-prompt@claude-prompt": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ultracost": {
      "source": {
        "source": "github",
        "repo": "danielkremen818/ultracost"
      }
    },
    "claude-prompt": {
      "source": {
        "source": "github",
        "repo": "danielkremen818/claude-prompt"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "high",
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}
