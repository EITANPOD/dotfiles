# ┌───────────────────────────────────────────────────────────────────────────┐
# │                           Ghostty Configuration                            │
# └───────────────────────────────────────────────────────────────────────────┘

# Theme
theme = Catppuccin Mocha

# Font
font-family = JetBrainsMono Nerd Font Mono
font-size = 16

# Behavior
mouse-hide-while-typing = true

# Left Option = Alt (word-jump via Option+arrows). Right Option keeps special chars (é, ∑…).
macos-option-as-alt = left

# Visual effects
background-blur-radius = 20

# Keybinds
# cmd+1 freed for herdr's next_agent binding; tab-1 moved to cmd+shift+1.
keybind = cmd+1=unbind
keybind = cmd+shift+1=goto_tab:1
